# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Stripe (test mode only) ---
# Dashboard → Developers → API keys (with "Test mode" switched on)
STRIPE_SECRET_KEY=sk_test_...
# Publishable key is the only Stripe key that may reach the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Local: printed by `stripe listen --forward-to localhost:3000/api/webhook`
# Production: Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
